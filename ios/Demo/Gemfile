source 'https://rubygems.org'

gem 'cocoapods', '~> 1.16'

# Podfile plugin that autolinks npm packages shipping lynx.lib.json. Provides
# `use_lynx_library!`, without which `pod install` cannot resolve the Podfile.
gem 'cocoapods-lynx-library', '~> 4.0'

# Its Capacitor counterpart. Published verification deliberately resolves the
# RubyGem, while day-to-day development keeps using the checkout.
if ENV['LYNX_CAPACITOR_USE_PUBLISHED'] == 'true'
  gem 'cocoapods-lynx-capacitor', '0.1.0'
else
  gem 'cocoapods-lynx-capacitor', :path => '../../gems/cocoapods-lynx-capacitor'
end

# XcodeGen consumes project.yml; installed separately (brew install xcodegen).
