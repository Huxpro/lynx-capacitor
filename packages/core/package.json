{
  "name": "@lynx-capacitor/core",
  "version": "0.1.0",
  "description": "Capacitor bridge reimplemented over the Lynx NativeModule API. Drop-in replacement for @capacitor/core so unmodified @capacitor/* plugins run on Lynx.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "capacitor",
    "lynx",
    "reactlynx",
    "native-module",
    "bridge"
  ],
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "~5.9.3"
  }
}
